# Where the frontend should send API calls.
# Local dev (with backend running via `npm run dev` in server/):
VITE_API_URL=http://localhost:4000
# Production example:
# VITE_API_URL=https://teamtracker-api.up.railway.app

# Google OAuth Web client ID (must match the server GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=team-tracker-500618.apps.googleusercontent.com
