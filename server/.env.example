# Postgres connection string. On Railway/Neon/Supabase, copy from the dashboard.
# Local dev with Docker: postgresql://postgres:postgres@localhost:5432/teamtracker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamtracker"

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# How long issued tokens stay valid (e.g. 30d, 7d, 12h).
JWT_EXPIRES_IN="30d"

# Allowed browser origins (comma-separated). Use "*" to allow any (dev only).
# Example for production: https://teamtracker.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Port the API listens on. Hosting platforms usually inject this automatically.
PORT="4000"
